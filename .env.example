# Copy this file to `.env` and adjust the values. `.env` is never committed.

# PostgreSQL connection string. Local development and tests use a disposable
# database (`npm run db:up`, host port 5433); production uses Supabase
# (data-model §7).
DATABASE_URL=postgresql://hexablock:hexablock@localhost:5433/hexablock?schema=public

# Port the API listens on. Optional; defaults to 3000.
PORT=3000
